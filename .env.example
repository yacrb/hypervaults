# HyperVaults workshop profile.
# Copy to .env on the droplet and replace every "change-me" value before the event.
# All values here are fake training placeholders. Do not store real secrets in git.

# ---------------------------------------------------------------------------
# Public hostnames
# ---------------------------------------------------------------------------
# DOMAIN is the main public hostname for the vulnerable app.
# Service subdomains are optional and handled by your DNS provider/reverse proxy.
DOMAIN=hypervaults.io
APP_HOST=hypervaults.io
MAILPIT_HOST=mailpit.hypervaults.io
REGISTRY_HOST=registry.hypervaults.io
ACME_EMAIL=admin@hypervaults.io

# Compose publishes container Nginx only on localhost:8080 by default. Put Caddy,
# host Nginx, Cloudflare Tunnel, or another TLS edge in front of this on a droplet.
# For direct HTTP testing without TLS, use HTTP_BIND=0.0.0.0 and HTTP_PORT=80.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
ADMIN_BIND=127.0.0.1

# ---------------------------------------------------------------------------
# App mode and URLs
# ---------------------------------------------------------------------------
APP_ENV=workshop
CHALLENGE_MODE=true
PUBLIC_APP_URL=https://hypervaults.io
PUBLIC_API_URL=https://hypervaults.io/api
NEXT_PUBLIC_API_BASE_URL=/api
OBJECTS_PUBLIC_BASE_URL=https://hypervaults.io/objects
MAILPIT_UI_PUBLIC_URL=https://mailpit.hypervaults.io/mailpit/

# Cloudflare Turnstile keys. Keep real secrets only in ignored .env.
# The values below are Cloudflare's dummy local-testing pair.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_DEV_BYPASS=false

# Backend/API
CORS_ALLOWED_ORIGINS=https://hypervaults.io,http://localhost:8080
MAX_UPLOAD_BYTES=10485760

# ---------------------------------------------------------------------------
# Database and auth
# ---------------------------------------------------------------------------
POSTGRES_DB=hypervaults
POSTGRES_USER=hypervaults
POSTGRES_PASSWORD=change-me-postgres-password
DATABASE_URL=postgresql+psycopg://hypervaults:change-me-postgres-password@postgres:5432/hypervaults

JWT_SECRET=change-me-to-a-random-32-byte-or-longer-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
MINIO_ROOT_USER=hypervaults-admin
MINIO_ROOT_PASSWORD=change-me-minio-root-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=hypervaults-files
MINIO_PRESIGNED_PUBLIC_BASE_URL=https://hypervaults.io/minio

# ---------------------------------------------------------------------------
# Mail capture
# ---------------------------------------------------------------------------
# Mailpit SMTP is internal only. The public UI is exposed only through Nginx with
# Basic Auth and read-only method filtering in challenge mode.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=HyperVaults Staging <no-reply@hypervaults.io>
MAILPIT_BASIC_USER=devmail
MAILPIT_BASIC_PASSWORD=change-me-mailpit-password

# ---------------------------------------------------------------------------
# Reverse proxy and challenge toggles
# ---------------------------------------------------------------------------
NGINX_CONFIG_FILE=./nginx/nginx.conf.challenge
ENABLE_X_FORWARDED_DOCS_BYPASS=true
ENABLE_TRACE_MAIL_DIAGNOSTICS=true
ENABLE_MAILPIT_EXPOSURE=true
ENABLE_PUBLIC_MINIO_BUCKET=true
ENABLE_OBJECTS_GATEWAY=true

# Harbor is optional because upstream Harbor ships as its own Compose stack.
# Leave the discovery branch false until Harbor has been installed and seeded.
ENABLE_HARBOR_REGISTRY=false
ENABLE_HARBOR_DEFAULT_CREDS_BRANCH=false
HARBOR_HOST=registry.hypervaults.io
HARBOR_ADMIN_USER=admin
HARBOR_ADMIN_PASSWORD=change-me-harbor-admin-password

# ---------------------------------------------------------------------------
# Training flags
# ---------------------------------------------------------------------------
FLAG_DOCS_BYPASS=Securinets{headers_dont_lie_they_get_forwarded}
FLAG_TRACE_MAIL=Securinets{trace_it_till_you_make_it}
FLAG_MAILPIT_INBOX=Securinets{dev_mailboxes_do_not_belong_in_prod}
FLAG_MINIO_PUBLIC_BUCKET=Securinets{public_buckets_make_private_uploads_public}
FLAG_HARBOR_DEBUG_IMAGE=Securinets{debug_images_should_not_reach_prod_registries}
