POSTGRES_DB=hypervaults
POSTGRES_USER=hypervaults
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql+psycopg://hypervaults:change-me-local-postgres-password@postgres:5432/hypervaults

JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

MINIO_ROOT_USER=hypervaults-local-admin
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=hypervaults-files
MINIO_PRESIGNED_PUBLIC_BASE_URL=http://localhost/minio

TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_DEV_BYPASS=false

# --- Challenge flags ---
# Secure defaults: all false, secure nginx config selected.
CHALLENGE_MODE=false
NGINX_CONFIG_FILE=./nginx/nginx.conf

# First challenge branch: X-Forwarded-For docs bypass (OWASP A02)
ENABLE_X_FORWARDED_DOCS_BYPASS=false

# Second challenge branch: TRACE mail diagnostics + exposed Mailpit (OWASP A02)
# Set all four and switch to the challenge nginx config to enable this branch.
ENABLE_TRACE_MAIL_DIAGNOSTICS=false
ENABLE_MAILPIT_EXPOSURE=false

# Third challenge branch: public MinIO bucket + unauthenticated object gateway (OWASP A02)
# ENABLE_PUBLIC_MINIO_BUCKET: minio-init sets the bucket policy to public read+list
#   and seeds flag.txt plus hint files into the bucket.
# ENABLE_OBJECTS_GATEWAY: backend includes a direct public_object_url in download
#   responses, making the open bucket discoverable from the API.
# Both require NGINX_CONFIG_FILE=./nginx/nginx.conf.challenge for the /objects/ proxy.
ENABLE_PUBLIC_MINIO_BUCKET=false
ENABLE_OBJECTS_GATEWAY=false
OBJECTS_PUBLIC_BASE_URL=http://localhost/objects

# --- Mailpit SMTP settings ---
# Backend uses Mailpit as a local SMTP catcher — no real external email is sent.
# SMTP port 1025 is internal only. Mailpit web UI port 8025 is internal only;
# it is proxied through Nginx at /mailpit/ only when using nginx.conf.challenge
# and ENABLE_MAILPIT_EXPOSURE=true.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=HyperVaults Dev <no-reply@hypervaults.local>
MAILPIT_UI_PUBLIC_URL=http://localhost/mailpit
# INTENTIONAL CHALLENGE VULNERABILITY: these credentials are intentionally weak.
# They are leaked by TRACE /api/diagnostics/mail when the challenge is enabled.
MAILPIT_BASIC_USER=devmail
MAILPIT_BASIC_PASSWORD=devmail2026

NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
NEXT_PUBLIC_API_BASE_URL=/api
