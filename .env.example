# HyperVaults local training configuration.
# Values here are fake CTF/lab defaults, not production-safe settings.

# App mode
APP_ENV=local
CHALLENGE_MODE=false

# Frontend and public URLs
PUBLIC_APP_URL=http://localhost
PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_API_BASE_URL=/api
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
OBJECTS_PUBLIC_BASE_URL=http://localhost/objects
MAILPIT_UI_PUBLIC_URL=http://localhost/mailpit

# Backend/API
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
MAX_UPLOAD_BYTES=10485760

# Database
POSTGRES_DB=hypervaults
POSTGRES_USER=hypervaults
POSTGRES_PASSWORD=change-me-local-postgres-password
DATABASE_URL=postgresql+psycopg://hypervaults:change-me-local-postgres-password@postgres:5432/hypervaults

# JWT/auth
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Turnstile
# The listed key pair is Cloudflare's documented dummy pair for local testing.
# For real Turnstile credentials, replace both values and authorize your hostname in Cloudflare.
TURNSTILE_DEV_BYPASS=false
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# MinIO/object storage
MINIO_ROOT_USER=hypervaults-local-admin
MINIO_ROOT_PASSWORD=change-me-local-minio-password
MINIO_ENDPOINT=minio:9000
MINIO_BUCKET=hypervaults-files
MINIO_PRESIGNED_PUBLIC_BASE_URL=http://localhost/minio

# Mail/Mailpit
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM=HyperVaults Dev <no-reply@hypervaults.local>
MAILPIT_BASIC_USER=devmail
MAILPIT_BASIC_PASSWORD=devmail2026

# Nginx/proxy
NGINX_CONFIG_FILE=./nginx/nginx.conf

# Challenge toggles
# Secure mode keeps all of these false. Use nginx.conf.challenge only for challenge mode.
ENABLE_X_FORWARDED_DOCS_BYPASS=false
ENABLE_TRACE_MAIL_DIAGNOSTICS=false
ENABLE_MAILPIT_EXPOSURE=false
ENABLE_PUBLIC_MINIO_BUCKET=false
ENABLE_OBJECTS_GATEWAY=false
ENABLE_HARBOR_REGISTRY=false
ENABLE_HARBOR_DEFAULT_CREDS_BRANCH=false

# Fake CTF flags and credentials.
# For DigitalOcean/event deployment, edit these values in the droplet's .env.
FLAG_DOCS_BYPASS=flag{trusted_proxy_headers_are_not_user_input}
FLAG_TRACE_MAIL=flag{trace_mail_diagnostics_exposed}
FLAG_MAILPIT_INBOX=flag{dev_mailboxes_do_not_belong_in_prod}
FLAG_MINIO_PUBLIC_BUCKET=flag{public_buckets_make_private_uploads_public}
FLAG_HARBOR_DEBUG_IMAGE=flag{debug_images_should_not_reach_prod_registries}

# Harbor/registry branch
# Harbor itself is external to the main compose stack. See harbor/README.md.
HARBOR_HOST=registry.hypervaults.local
HARBOR_ADMIN_USER=admin
HARBOR_ADMIN_PASSWORD=Harbor12345
