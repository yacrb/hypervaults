events {
    worker_connections 1024;
}

http {
    upstream frontend_app {
        server frontend:3000;
    }

    upstream backend_app {
        server backend:8000;
    }

    upstream minio_api {
        server minio:9000;
    }

    # INTENTIONAL CHALLENGE VULNERABILITY (second branch):
    # Mailpit web UI is proxied through Nginx when ENABLE_MAILPIT_EXPOSURE=true.
    # Credentials are intentionally weak and leaked by the TRACE diagnostics endpoint.
    upstream mailpit_ui {
        server mailpit:8025;
    }

    server {
        listen 80;
        server_name _;

        client_max_body_size 12m;

        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header Permissions-Policy "accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), usb=()" always;
        error_page 405 = @trace_mail_diagnostics;

        # INTENTIONAL CHALLENGE VULNERABILITY (second branch):
        # TRACE is NOT blocked globally in challenge mode. TRACE requests reach
        # /api/diagnostics/mail when ENABLE_TRACE_MAIL_DIAGNOSTICS=true on the backend.
        # The backend controls whether the TRACE route is registered; if not, it returns 404/405.

        # INTENTIONAL CHALLENGE VULNERABILITY (first branch):
        # These docs endpoints forward the client-provided X-Forwarded-For header.
        # The vulnerable backend challenge flag then trusts spoofed localhost values.
        location = /api/docs {
            proxy_pass http://backend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/openapi.json {
            proxy_pass http://backend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location = /api/redoc {
            proxy_pass http://backend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # INTENTIONAL CHALLENGE VULNERABILITY (second branch):
        # TRACE /api/diagnostics/mail is allowed through to the backend.
        # The backend only handles it when ENABLE_TRACE_MAIL_DIAGNOSTICS=true.
        # The spoofed X-Forwarded-For header is preserved here so players can chain
        # the first vulnerability (docs bypass) with the second (TRACE diagnostics).
        location = /api/diagnostics/mail {
            error_page 405 = @trace_mail_diagnostics;
            proxy_pass http://backend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Nginx rejects TRACE itself with 405. This internal location is scoped to
        # the single diagnostics endpoint so challenge mode can demonstrate the
        # intentionally unsafe backend TRACE handler without enabling TRACE broadly.
        location @trace_mail_diagnostics {
            if ($request_uri != "/api/diagnostics/mail") {
                return 405;
            }

            proxy_method TRACE;
            proxy_pass http://backend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $http_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Regular API routes keep normal proxy header behavior.
        location /api/ {
            proxy_pass http://backend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # INTENTIONAL CHALLENGE VULNERABILITY (second branch):
        # Mailpit web UI exposed at /mailpit/ with intentionally weak Basic Auth.
        # Credentials are generated from Compose environment values and leaked by TRACE /api/diagnostics/mail.
        # The htpasswd file is generated at container startup by nginx/entrypoint.sh.
        location /mailpit/ {
            auth_basic "Mail Diagnostics";
            auth_basic_user_file /etc/nginx/auth/mailpit.htpasswd;

            proxy_pass http://mailpit_ui;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            # Mailpit uses WebSocket for live message updates.
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
        }

        # INTENTIONAL CHALLENGE VULNERABILITY (third branch — OWASP A02):
        # Public object gateway. Combined with the public bucket policy set by
        # minio-init (ENABLE_PUBLIC_MINIO_BUCKET=true), this makes the entire
        # bucket anonymously browsable and downloadable — no credentials needed.
        # Players discover it via the direct object URL returned in the download
        # API response, then browse to /objects/hypervaults-files/ to list all files.
        # Do not add authentication here; the misconfiguration is the point.
        location /objects/ {
            limit_except GET HEAD {
                deny all;
            }

            rewrite ^/objects/(.*)$ /$1 break;
            proxy_pass http://minio_api;
            proxy_http_version 1.1;
            proxy_set_header Host minio:9000;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # Presigned object downloads use private MinIO URLs issued only after API ownership checks.
        # Only GET and HEAD are allowed here; the MinIO console is never proxied.
        location /minio/ {
            limit_except GET HEAD {
                deny all;
            }

            rewrite ^/minio/(.*)$ /$1 break;
            proxy_pass http://minio_api;
            proxy_http_version 1.1;
            proxy_set_header Host minio:9000;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        # The Next.js frontend owns all non-API browser routes.
        location / {
            proxy_pass http://frontend_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }

    # INTENTIONAL CHALLENGE VULNERABILITY (fourth branch — OWASP A02):
    # Harbor registry proxied at registry.hypervaults.local (and .io for hosted).
    # Harbor runs as a separate Docker Compose stack on host port 8090.
    # Add "127.0.0.1 registry.hypervaults.local" to /etc/hosts for local use.
    # host.docker.internal reaches the Docker Desktop host on Mac/Windows.
    # On Linux, replace with the Docker bridge IP: 172.17.0.1
    # See harbor/README.md for Harbor setup instructions.
    upstream harbor_proxy {
        server host.docker.internal:8090;
    }

    server {
        listen 80;
        server_name registry.hypervaults.local registry.hypervaults.io;

        # Harbor image layers can be large.
        client_max_body_size 500m;

        # INTENTIONAL CHALLENGE VULNERABILITY: Harbor is proxied without
        # additional authentication. The intentionally weak training credentials
        # are the vulnerability — players discover them via the Mailpit email.
        location / {
            proxy_pass http://harbor_proxy;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 900s;
            proxy_send_timeout 900s;
            # Required for Docker client chunked uploads.
            proxy_buffering off;
            proxy_request_buffering off;
        }
    }
}
